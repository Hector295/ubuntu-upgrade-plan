#!/bin/sh
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
record "do-release-upgrade $*"
fail_if do-release-upgrade
sed -i "s/^VERSION_ID=.*/VERSION_ID=\"${TARGET_VERSION:-24.04}\"/" "$ROOT/etc/os-release"
# Simulates the upgrader disabling a third-party source, as it does without --allow-third-party.
if [ -f "$STUB_STATE/dru-disable-vendor" ]; then
  mkdir -p "$ROOT/etc/apt/sources.list.d"
  echo "# deb http://repo.vendor.example/apt noble main # disabled on upgrade to noble" > "$ROOT/etc/apt/sources.list.d/vendor.list"
fi
exit 0
