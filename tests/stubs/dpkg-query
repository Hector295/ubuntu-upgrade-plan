#!/bin/sh
# dpkg-query stub: supports -W -f='${Status}' pkg and -W -f='${db:Status-Abbrev} ${Package}\n' patterns...
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
fmt=""
pats=""
for a in "$@"; do
  case "$a" in
    -W) ;;
    -f=*) fmt=${a#-f=} ;;
    *) pats="$pats $a" ;;
  esac
done
set -f
case "$fmt" in
  *db:Status-Abbrev*)
    # Like real dpkg: a held package (apt-mark hold) shows up as "hi", not "ii".
    found=1
    while read -r pkg; do
      for pat in $pats; do
        # shellcheck disable=SC2254
        case "$pkg" in $pat)
          if held "$pkg"; then echo "hi  $pkg"; else echo "ii  $pkg"; fi
          found=0; break ;;
        esac
      done
    done < "$STUB_STATE/installed"
    exit $found ;;
  *)
    # shellcheck disable=SC2086
    set -- $pats
    if installed "$1"; then
      case "$fmt" in
        *db:Status-Status*) printf 'installed' ;;
        *) if held "$1"; then printf 'hold ok installed'; else printf 'install ok installed'; fi ;;
      esac
      exit 0
    fi
    exit 1 ;;
esac
