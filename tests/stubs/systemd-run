#!/bin/sh
# Stub de systemd-run: ejecuta la unidad de forma síncrona sobre la raíz falsa.
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
record "systemd-run $*"
fail_if systemd-run
for a in "$@"; do
  case "$a" in --*) ;; *) set -- "$@" "$a" ;; esac
done
# Los dos últimos argumentos: ruta del script en el host y subcomando.
while [ $# -gt 2 ]; do shift; done
rc=0
sh "$ROOT$1" "$2" >> "$STUB_STATE/unit.log" 2>&1 || rc=$?
echo "$rc" > "$STUB_STATE/unit.rc"
exit 0
