#!/bin/sh
# systemd-run stub: runs the unit synchronously on the fake root.
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
record "systemd-run $*"
fail_if systemd-run
for a in "$@"; do
  case "$a" in --*) ;; *) set -- "$@" "$a" ;; esac
done
# The last two arguments: host script path and subcommand.
while [ $# -gt 2 ]; do shift; done
rc=0
sh "$ROOT$1" "$2" >> "$STUB_STATE/unit.log" 2>&1 || rc=$?
echo "$rc" > "$STUB_STATE/unit.rc"
exit 0
